enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            Int          @id @default(autoincrement())
  customerName  String
  email         String
  totalAmount   Float
  status        OrderStatus  @default(PENDING)
  priority      Priority     @default(NORMAL)
  createdAt     DateTime     @default(now())

  logs          Log[]
}

model Log {
  id        Int      @id @default(autoincrement())
  orderId   Int
  eventType String
  source    String
  status    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id])
}

model EventQueue {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  type      String
  payload   Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}